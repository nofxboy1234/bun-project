{
  "name": "bun-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:reset": "bun src/db/reset.ts",
    "db:push": "bunx --bun drizzle-kit push --verbose",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:random": "bun src/db/seedRandom.ts",
    "db:dump": "pg_dump --schema-only --file=./src/db/schema.sql bun-project",
    "db:erd:build": "bun db:dump && bunx liam erd build --input src/db/schema.sql --format postgres --output-dir erd",
    "db:studio": "bun --bun drizzle-kit studio --verbose",
    "db:erd:serve": "bunx --bun serve erd/",
    "db": "bun run db:reset && bun run db:push && bun run db:seed && bun run db:erd:build",
    "lint": "bunx --bun oxlint",
    "format": "FORCE_COLOR=1 bunx --bun prettier . --write",
    "ts": "bunx --bun tsc",
    "dev": "bun --bun vite dev --port 3000",
    "debug:dev": "bun --bun --inspect node_modules/.bin/vite dev --port 3000",
    "clean": "rm -rf dist && rm -f bun-project && echo 'Done cleaning.'",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --port 3000",
    "debug:preview": "bun --bun --inspect node_modules/.bin/vite preview --port 3000",
    "start": "NODE_ENV=production bun --bun server.tsx",
    "debug:start": "NODE_ENV=development bun --bun --inspect server.tsx"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.6",
    "@elysiajs/openapi": "^1.4.13",
    "@tanstack/react-devtools": "^0.9.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.144.0",
    "@tanstack/react-router-devtools": "^1.144.0",
    "@tanstack/react-router-ssr-query": "^1.144.0",
    "@tanstack/react-start": "^1.145.3",
    "@tanstack/router-plugin": "^1.145.2",
    "drizzle-kit": "^1.0.0-beta.8-dbc3565",
    "drizzle-orm": "^1.0.0-beta.8-dbc3565",
    "drizzle-seed": "^1.0.0-beta.8-dbc3565",
    "drizzle-typebox": "^0.3.3",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.19",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite-tsconfig-paths": "^6.0.3",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@liam-hq/cli": "^0.7.24",
    "@tanstack/devtools-vite": "^0.4.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "oxlint": "^1.36.0",
    "prettier": "^3.7.4",
    "serve": "^14.2.5",
    "vite": "^7.3.0"
  },
  "overrides": {
    "@sinclair/typebox": ">= 0.34.0 < 1"
  }
}
